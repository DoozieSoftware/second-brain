# ─── Required ────────────────────────────────────────────────────────────────

# OpenRouter API key — get a free key at https://openrouter.ai
# Free tier includes access to several capable models.
OPENROUTER_API_KEY=your-key-here

# ─── Optional: Override AI model ─────────────────────────────────────────────

# Default: the best free model available on OpenRouter.
# See models at https://openrouter.ai/models (filter by "free")
# DEFAULT_MODEL=nvidia/nemotron-nano-9b-v2:free

# Query timeout in milliseconds (default: 90000 = 90s)
# QUERY_TIMEOUT_MS=90000

# ─── Optional: API Security ──────────────────────────────────────────────────

# Set this to require a Bearer token on all API endpoints.
# Leave unset for open access (fine for local use; required for any deployment).
# API_KEY=your-secret-key-here

# ─── Connector: GitHub ───────────────────────────────────────────────────────
# Get a Personal Access Token at https://github.com/settings/tokens
# Required scopes: repo (or public_repo for public repos only)
# GITHUB_TOKEN=ghp_your_token_here

# Optional: limit sync to a specific org (syncs all accessible repos if unset)
# GITHUB_ORG=your-org-name

# ─── Connector: Email (Multi-mailbox IMAP) ───────────────────────────────────
#
# Option A: Multi-mailbox (recommended) — JSON array of accounts
# Each account can specify IMAP host, folders to sync, and optional SMTP.
# For Gmail: use App Passwords (https://myaccount.google.com/apppasswords)
#
# EMAIL_ACCOUNTS=[{"name":"akshay","host":"imap.gmail.com","port":993,"user":"ak@company.com","password":"app-password","folders":["INBOX","Important"],"smtp":{"host":"smtp.gmail.com","port":587,"user":"ak@company.com","password":"app-password"}},{"name":"team-eng","host":"imap.gmail.com","port":993,"user":"engineering@company.com","password":"app-password","folders":["INBOX","P0-Alerts"]},{"name":"support","host":"imap.gmail.com","port":993,"user":"support@company.com","password":"app-password","folders":["INBOX"]}]
#
# Option B: Single mailbox (simpler)
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=you@example.com
# IMAP_PASSWORD=your-app-password

# ─── Connector: Google Drive ─────────────────────────────────────────────────
#
# Option A: Service Account (recommended for server deployments)
# 1. Go to https://console.cloud.google.com/
# 2. Create a project, enable Google Drive API
# 3. Create a Service Account, download JSON key
# 4. Share your Drive folder with the service account email
# GDRIVE_SERVICE_ACCOUNT_KEY=./credentials/gdrive-service-account.json
#
# Option B: OAuth2 Client (for personal use)
# 1. Create OAuth2 credentials at https://console.cloud.google.com/apis/credentials
# 2. Get a refresh token using the OAuth2 playground or gcloud CLI
# GDRIVE_CLIENT_ID=your-client-id
# GDRIVE_CLIENT_SECRET=your-client-secret
# GDRIVE_REFRESH_TOKEN=your-refresh-token
#
# Optional: limit to a specific folder
# GDRIVE_FOLDER_ID=your-folder-id

# ─── Connector: Dropbox ──────────────────────────────────────────────────────
#
# Option A: Access Token (simple, expires in 4 hours)
# 1. Go to https://www.dropbox.com/developers/apps
# 2. Create app with "Full Dropbox" access
# 3. Generate access token
# DROPBOX_ACCESS_TOKEN=your-access-token
#
# Option B: Refresh Token (long-lived, recommended)
# 1. Create app as above, note App Key and Secret
# 2. Authorize via OAuth2 flow to get a refresh token
# DROPBOX_APP_KEY=your-app-key
# DROPBOX_APP_SECRET=your-app-secret
# DROPBOX_REFRESH_TOKEN=your-refresh-token
#
# Optional: limit to specific folders (comma-separated)
# DROPBOX_PATHS=/Documents,/Projects

# ─── Connector: Google Calendar ──────────────────────────────────────────────
# Get an API key at https://console.cloud.google.com/apis/credentials
# Enable the "Google Calendar API" for your project first.
# GOOGLE_CALENDAR_API_KEY=your-google-api-key

# ─── File Import ─────────────────────────────────────────────────────────────
# Import files directly via the API:
#   POST /import          — multipart/form-data with field "files" (up to 50 files, 100MB each)
#   POST /import/url      — JSON: { "url": "https://...", "label": "optional" }
#   GET  /sources         — list all configured sources and import info
#
# Supported formats: PDF, DOCX, XLSX, PPTX, MD, TXT, CSV, JSON, HTML, RTF, EPUB,
#                    and all code files (.ts, .js, .py, .go, .rs, .java, etc.)

# ─── Server ──────────────────────────────────────────────────────────────────
# PORT=3000

# ─── Dreaming (offline memory consolidation) ─────────────────────────────────
# The brain consolidates memory (dedup + association mining + gap detection)
# when the server has been idle. Run manually anytime with `npx tsx src/cli.ts dream`.
# DREAM_ENABLED=true
# DREAM_IDLE_MINUTES=30         # idle threshold before a dream fires
# DREAM_COOLDOWN_MINUTES=120    # minimum gap between dreams

# ─── Identity & RBAC ─────────────────────────────────────────────────────────
# Users are created via the API (POST /admin/users) or CLI (user:create).
# Once any user exists, identity mode activates: every request needs a
# per-user API key (Authorization: Bearer <key>).
#
# Legacy single-shared-key mode (used only if no users exist):
# API_KEY=your-secret-key-here
#
# Leave both unset for open access (fine for local use; NOT for any deployment).

# ─── Integration Adapters (CTO Command Center) ──────────────────────────────
# Each adapter reads its own env vars. Unset adapters simply report
# "not configured" on GET /integrations.

# GitLab (Personal Access Token: https://gitlab.com/-/user_settings/personal_access_tokens)
# GITLAB_HOST=https://gitlab.com
# GITLAB_TOKEN=glpat_your_token_here
# GITLAB_ORG=your-group

# Jira (Atlassian API token + email)
# JIRA_HOST=your-org.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=your-api-token
# JIRA_PROJECTS=PROJ,ENG

# Linear
# LINEAR_API_KEY=lin_api_your_key

# Slack (Bot token, xoxb- prefix)
# SLACK_BOT_TOKEN=xoxb-your-token
# SLACK_CHANNELS=general,eng-team

# Discord (Bot token)
# DISCORD_BOT_TOKEN=your-bot-token
# DISCORD_CHANNELS=general,engineering

# Notion (Internal Integration token: nt_...)
# NOTION_API_KEY=nt_your_key
# NOTION_DATABASES=docs,decisions

# Confluence (Atlassian API token, same credentials as Jira)
# CONFLUENCE_HOST=your-org.atlassian.net
# CONFLUENCE_EMAIL=you@company.com
# CONFLUENCE_API_TOKEN=your-api-token
# CONFLUENCE_SPACES=ENG

# CRM (HubSpot-style private app token)
# CRM_API_KEY=pat-your-key
# CRM_OBJECTS=companies,deals

# Google Workspace (see GDRIVE_* above for service-account setup)
# GWORKSPACE_SERVICE_ACCOUNT_KEY=./credentials/gworkspace-service-account.json
# GWORKSPACE_ADMIN=admin@company.com

# Internal API (your org's own HTTP API)
# INTERNAL_API_URL=https://api.internal.company.com
# INTERNAL_API_TOKEN=your-token
