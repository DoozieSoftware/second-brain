# ─── Required ────────────────────────────────────────────────────────────────

# OpenRouter API key — get a free key at https://openrouter.ai
# Free tier includes access to several capable models.
OPENROUTER_API_KEY=your-key-here

# ─── Optional: Override AI model ─────────────────────────────────────────────

# Default: the best free model available on OpenRouter.
# See models at https://openrouter.ai/models (filter by "free")
# DEFAULT_MODEL=google/gemini-2.0-flash-lite:free

# ─── Optional: API Security ──────────────────────────────────────────────────

# Set this to require a Bearer token on all API endpoints.
# Leave unset for open access (fine for local use; required for any deployment).
# API_KEY=your-secret-key-here

# ─── Connector: GitHub ───────────────────────────────────────────────────────
# Get a Personal Access Token at https://github.com/settings/tokens
# Required scopes: repo (or public_repo for public repos only)
# GITHUB_TOKEN=ghp_your_token_here

# Optional: limit sync to a specific org (syncs all accessible repos if unset)
# GITHUB_ORG=your-org-name

# ─── Connector: Email (IMAP) ─────────────────────────────────────────────────
# Works with Gmail, Outlook, or any IMAP server.
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=you@example.com
# IMAP_PASSWORD=your-app-password

# ─── Connector: Google Calendar ──────────────────────────────────────────────
# Get an API key at https://console.cloud.google.com/apis/credentials
# Enable the "Google Calendar API" for your project first.
# GOOGLE_CALENDAR_API_KEY=your-google-api-key

# ─── Server ──────────────────────────────────────────────────────────────────
# PORT=3000
